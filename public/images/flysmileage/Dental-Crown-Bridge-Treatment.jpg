<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
document.getElementById("leadForm").addEventListener("submit", function (e) {
  e.preventDefault();

  const vendor_key = "14DD3A1D-3866-4EBE-8813-0C99A51A0096"; // ✅ Use your key

  const formData = new FormData(this);
  const payload = Object.fromEntries(formData.entries());

  payload.vendor_key = vendor_key;
  payload.LeadSource = "Website API Form";

  console.log("Sending Payload:", payload); // Optional: Debug

  fetch("https://flydentalclinic.leadpluss.com/Services/api/TenantLeads/Submit", {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify(payload)
  })
  .then(response => response.json())
  .then(data => {
    console.log("LeadPluss Response:", data);
    window.location.href = "thank-you.php";
  })
  .catch(error => {
    console.error("Error submitting lead:", error);
    alert("Something went wrong. Please try again.");
  });
});
</script>
